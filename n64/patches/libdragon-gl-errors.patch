index e8b2b74..c2d82eb 100644
--- a/src/GL/gl_internal.h
+++ b/src/GL/gl_internal.h
@@ -52,10 +52,28 @@
     dirty_flag; \
 })
 
+/* An OpenGL error is recorded for glGetError(), as the GL specification
+ * says: programs written for desktop GL probe for features this way (e.g.
+ * glGetIntegerv(GL_MAJOR_VERSION) on a GL 1.x context). The same goes for
+ * valid parameters this implementation does not support (two-sided
+ * lighting, some blend factors, ...): they are reported as GL_INVALID_ENUM
+ * instead of stopping the program. The first errors are logged;
+ * GL_ASSERT_ERRORS makes them assertions again. */
+#ifdef GL_ASSERT_ERRORS
 #define gl_set_error(error, message, ...)  ({ \
     state->current_error = error; \
     assertf(error == GL_NO_ERROR, "%s: " message, #error, ##__VA_ARGS__); \
 })
+#else
+extern int __gl_errors_logged;
+#define gl_set_error(error, message, ...)  ({ \
+    state->current_error = error; \
+    if (error != GL_NO_ERROR && __gl_errors_logged < 50) { \
+        __gl_errors_logged++; \
+        debugf("GL: %s: " message "\n", #error, ##__VA_ARGS__); \
+    } \
+})
+#endif
 
 #define gl_ensure_no_begin_end() ({ \
